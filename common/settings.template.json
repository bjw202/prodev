{
  "permissions": {
    "allow": [
      "mcp__minidiscord-channel__reply",
      "mcp__minidiscord-channel__fetch_history",
      "Read",
      "Agent",
      "WebSearch",
      "WebFetch",
      "Edit({{PROJECT}}/**)",
      "Write({{PROJECT}}/**)",
      "Edit({{BOT}}/**)",
      "Write({{BOT}}/**)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(cat:*)",
      "Bash(sed:*)",
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(date:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(chmod:*)",
      "Bash(shasum:*)",
      "Bash(sha256sum:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(cd:*)",
      "Bash(tr:*)",
      "Bash(cut:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)"
    ],
    "deny": [
      "Edit({{BOT}}/.claude/settings.json)",
      "Edit({{BOT}}/.env)",
      "Edit({{BOT}}/.mcp.json)",
      "Edit({{PRODEV}}/common/hooks/**)",
      "Edit({{PRODEV}}/scripts/**)",
      "Write({{UPLOADS}}/**)",
      "Edit({{UPLOADS}}/**)"
    ],
    "additionalDirectories": ["{{PROJECT_DIR}}", "{{UPLOADS_DIR}}", "{{PRODEV_DIR}}"]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "PATH": "{{PATH}}",
    "PRODEV_BOT": "{{BOT_NAME}}",
    "PRODEV_PROJECT": "{{PROJECT_DIR}}",
    "MINIDISCORD_DB": "{{DB}}"
  },
  "statusLine": { "type": "command", "command": "{{STATUSLINE}}" },
  "autoCompactEnabled": true,
  "autoCompactWindow": "{{AUTOCOMPACT}}",
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact",
        "hooks": [ { "type": "command", "command": "node {{HOOKS}}/session-start.js" } ] }
    ],
    "PreCompact": [
      { "matcher": "",
        "hooks": [ { "type": "command", "command": "node {{HOOKS}}/pre-compact.js", "timeout": 180 } ] }
    ],
    "PreToolUse": [
      { "matcher": "mcp__minidiscord-channel__reply",
        "hooks": [ { "type": "command", "command": "node {{HOOKS}}/pre-reply.js" } ] }
    ]
  }
}
